{
  "manifest_version": 3,
  "name": "行迹 · 飞常准连接",
  "version": "1.0.0",
  "description": "仅为行迹网页访问飞常准接口补充会话响应头的读取声明。",
  "minimum_chrome_version": "101",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://yuanzesun.github.io/*", "https://c-gw.variflight.com/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "flight_session", "enabled": true, "path": "rules.json" }]
  }
}
