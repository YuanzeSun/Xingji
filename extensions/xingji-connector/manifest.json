{
  "manifest_version": 3,
  "name": "行迹 · 连接扩展",
  "version": "1.2.1",
  "description": "供行迹读取 12306 乘车明细和查询飞常准行程。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://cx.12306.cn/*", "https://yuanzesun.github.io/*", "https://c-gw.variflight.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "externally_connectable": { "matches": ["https://yuanzesun.github.io/Xingji/*"] },
  "declarative_net_request": {
    "rule_resources": [{ "id": "flight_session", "enabled": true, "path": "rules.json" }]
  }
}
